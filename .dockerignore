# Dependencies & build output (rebuilt inside the image)
node_modules
dist
dist-ssr

# VCS & CI
.git
.github
.gitignore

# AIVOUX framework / agent tooling (not needed for the build)
.claude
.aivoux
.mcp.json

# Docs, sessions, QA screenshots
docs
.playwright-mcp
*.md
!index.html

# Editor / OS noise
.vscode
.idea
.DS_Store
*.log

# Local-only artifacts
*.local
.env
.env.*
coverage
playwright-report
test-results

# Public VITE_* values are passed explicitly as Docker build arguments by deploy.sh.
